{
  "name": "@flow-marketplace/semantic-memory-mcp",
  "version": "2.2.0",
  "description": "MCP server for semantic code search using PostgreSQL + pgvector",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "semantic-memory-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "src",
    "scripts"
  ],
  "keywords": [
    "mcp",
    "semantic-search",
    "code-search",
    "postgresql",
    "pgvector"
  ],
  "author": "flow-community",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
